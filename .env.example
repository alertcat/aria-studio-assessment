# Copy to .env.local. Nothing here is needed for the read-only showcase.

# Mode
ARIA_MODE=
ARIA_COOKIE_SECRET=
DATA_ROOT=
# Demo mode (ARIA_MODE unset) is read-only unless this is set. Pilot mode ignores it.
#   replay  A public demo that needs no key. Template briefs, greenlight and
#           acceptance replay recorded runs from public/. No client is called,
#           nothing is saved, and every other write stays refused.
#   1       Every write. Only on a machine you control: demo mode has no login,
#           so this lets every caller write and spend the keys below.
ARIA_DEMO_WRITES=

# LLM
OPENROUTER_API_KEY=
LLM_GATEWAY_BASE=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_ALT_KEY=
APP_PUBLIC_URL=

# Render provider (video and image)
RENDER_API_BASE=
RENDER_API_KEY=
RENDER_ASSET_BASE=

# Optional testnet settlement
CHAIN_BUYER_PK=
CHAIN_STUDIO_ADDR=
BASE_SEPOLIA_RPC=

# Read-only showcase
NEXT_PUBLIC_READONLY=
NEXT_PUBLIC_LIVE_URL=
